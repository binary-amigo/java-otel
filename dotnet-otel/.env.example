# The application exports all three signals with OTLP over HTTP/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Point these at your OTLP/HTTP receiver.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://host.docker.internal:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://host.docker.internal:4318/v1/logs

# Comma-separated OTLP headers, for example: x-api-key=replace-me,X-Metrics-Type=otel
OTEL_EXPORTER_OTLP_HEADERS=

REQUESTS_PER_API=50
FAILED_REQUESTS_PER_API=10
CYCLE_SECONDS=300
SLOW_REQUESTS_PER_CYCLE=5
SLOW_REQUEST_DELAY_MS=1200
SLOW_DB_DELAY_MS=600
